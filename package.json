{
    "name":  "wilson-translator",
    "version":  "1.0.0",
    "description":  "Wilson Translation App",
    "main":  "dist/main/main.js",
    "homepage":  "./",
    "author":  "Wilson",
    "license":  "MIT",
    "scripts":  {
                    "dev":  "tsc --project tsconfig.electron.json \u0026\u0026 concurrently \"electron .\" \"vite\"",
                    "build":  "vite build \u0026\u0026 tsc --project tsconfig.electron.json",
                    "dist":  "npm run build \u0026\u0026 electron-builder --win --dir",
                    "pack":  "electron-builder --win --dir"
                },
    "dependencies":  {
                         "axios":  "^1.6.0",
                         "react":  "^18.2.0",
                         "react-dom":  "^18.2.0",
                         "translate-google":  "^1.5.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^20.0.0",
                            "@types/react":  "^18.2.0",
                            "@types/react-dom":  "^18.2.0",
                            "@vitejs/plugin-react":  "^4.0.0",
                            "concurrently":  "^8.0.0",
                            "cross-env":  "^7.0.3",
                            "electron":  "^27.0.0",
                            "electron-builder":  "^24.6.0",
                            "typescript":  "^5.0.0",
                            "vite":  "^5.0.0",
                            "vite-plugin-electron":  "^0.14.0",
                            "vite-plugin-electron-renderer":  "^0.14.0"
                        },
    "build":  {
                  "appId":  "com.wilson.translator",
                  "productName":  "Wilson专属翻译",
                  "files":  [
                                "dist/**/*",
                                "dist-electron/**/*"
                            ],
                  "directories":  {
                                      "output":  "release"
                                  },
                  "win":  {
                              "target":  [
                                             "portable"
                                         ],
                              "sign":  false
                          },
                  "portable":  {
                                   "artifactName":  "Wilson专属翻译.exe"
                               }
              }
}
